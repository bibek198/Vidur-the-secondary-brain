# GitHub fine-grained token, read-only access to public repositories
GITHUB_TOKEN=
# Anthropic API key (leave blank to run in replay mode)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
GRAPH_NAME=brain_eval

# 1 = serve recorded answers only (no LLM calls)
DEMO_REPLAY=0

# Real-time engine
POLL_INTERVAL_S=60
GIT_DIFF_INTERVAL_S=300
WEBHOOK_SECRET=
# Optional: protects the 'Replay next real change' button; open the page with ?demo=<token> to use it
DEMO_TOKEN=
SANDBOX_REPO=
# Graphs: brain_eval (frozen, evaluation), brain_live (follows kubernetes repos), brain_demo (sandbox webhook)
LIVE_GRAPH=brain_live
DEMO_GRAPH=brain_demo
# Spend cap for live re-extraction of rationales (USD)
REEXTRACT_BUDGET_USD=0.50
# Deployment (docker-compose.prod.yml): public HTTPS name, e.g. 13-201-5-9.sslip.io
DOMAIN=
# Public mode limits for live LLM questions (recorded example answers are free)
LIVE_PER_IP_HOUR=10
SPEND_CAP_USD=1.00
